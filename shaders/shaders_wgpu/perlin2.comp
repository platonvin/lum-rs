fn betterHash2D_vec4(cell: vec4<f32>) -> vec4<f32> {
    let i_val = vec4<u32>(cell);
    let hash_val = vec4<u32>(ihash1D_vec4(ihash1D_vec4(i_val.xzxz) + i_val.yyww));
    return vec4<f32>(vec4<f32>(hash_val) * (1.0 / f32(0xffffffffu)));
}

