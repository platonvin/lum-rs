// @group(0) @binding(0) var<uniform> world_size: Uniforms;

@compute @workgroup_size(8, 8, 1)
fn main(@builtin(global_invocation_id) global_id: vec3<u32>) {
    let fpix = vec2<f32>(vec2<f32>(global_id.xy) + 0.5);
    let ipix = vec2<i32>(fpix);
    let noise_val = perlinNoise_vec2_float(fpix/(2.0*vec2<f32>(world_size.xy)), vec2<f32>(3.0), 0.0);
    textureStore(noise_image, ipix, vec4<f32>(noise_val,noise_val,noise_val, 1.0));
}